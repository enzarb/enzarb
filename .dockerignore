# Build context is the repo root for components with in-repo path deps
# (docker build -f <dir>/Dockerfile .). Keep it small.
# Per-directory .dockerignore files do not apply with this context; add exclusions here.
**/target
**/node_modules
**/.git
.git
**/.svelte-kit
ui/build
ui/test-results
ui/playwright-report
**/.env
**/.env.*
!**/.env.example
docs
helm
kubernetes
.cloudflare
sandbox-container/tests
.claude
.ruckcode
