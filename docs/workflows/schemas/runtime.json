{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "install": {
      "$ref": "#/$defs/Tools",
      "default": {}
    },
    "launch": {
      "$ref": "#/$defs/Launch"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities",
      "default": {
        "sessions": false,
        "resume": false,
        "steering": false,
        "interactive": false,
        "structured_output": false
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SecretDecl"
      },
      "description": "Secrets the runtime needs (e.g. an API key), as in a step."
    }
  },
  "required": [
    "version",
    "launch"
  ],
  "description": "A named agent runtime.",
  "title": "RuntimeFile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mise": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "mise tool specs installed before the step (`node@22`)."
        }
      }
    },
    "Launch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "argv of the agent process."
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "protocol",
        "command"
      ]
    },
    "Protocol": {
      "type": "string",
      "enum": [
        "acp",
        "stdio-json"
      ]
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "type": "boolean",
          "default": false
        },
        "resume": {
          "type": "boolean",
          "default": false
        },
        "steering": {
          "type": "boolean",
          "default": false
        },
        "interactive": {
          "type": "boolean",
          "default": false
        },
        "structured_output": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "SecretDecl": {
      "anyOf": [
        {
          "type": "string",
          "description": "Project scope, injected as the env var `NAME`."
        },
        {
          "$ref": "#/$defs/Secret"
        }
      ],
      "description": "A named secret as written: `NAME` or `{name, scope, env | file}`."
    },
    "Secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SecretScope",
          "default": "project"
        },
        "env": {
          "type": [
            "string",
            "null"
          ],
          "description": "Environment variable to set."
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "File (relative to the workspace root) to write the value to."
        }
      },
      "required": [
        "name"
      ],
      "description": "A secret: where it is stored and how the process receives it."
    },
    "SecretScope": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "project",
            "instance"
          ]
        },
        {
          "type": "string",
          "const": "user",
          "description": "The user the step acts for."
        }
      ]
    }
  }
}
