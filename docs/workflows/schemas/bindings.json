{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "imports": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Binding"
      },
      "default": []
    }
  },
  "description": "A bindings file: triggers mapped to workflows (library `bindings.yaml`,\nProject `spec.workflows.bindings`, repo `.enzarb/workflows.yaml`).",
  "title": "BindingsFile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Name; a later layer's binding with the same id replaces this one."
        },
        "on": {
          "anyOf": [
            {
              "$ref": "#/$defs/Trigger"
            },
            {
              "type": "null"
            }
          ],
          "description": "The trigger. Required unless `disabled`."
        },
        "if": {
          "type": [
            "string",
            "null"
          ],
          "description": "MiniJinja expression over the routing context (`event`, `relations`)."
        },
        "with": {
          "type": "object",
          "additionalProperties": true,
          "description": "Params of the bound workflow. String leaves are templates over the\nrouting context."
        },
        "use": {
          "type": [
            "string",
            "null"
          ],
          "description": "Workflow file reference. Required unless `disabled`."
        },
        "disabled": {
          "type": "boolean",
          "description": "Removes an inherited binding with the same id."
        }
      }
    },
    "Trigger": {
      "anyOf": [
        {
          "type": "string",
          "description": "An event type (catalog or custom)."
        },
        {
          "type": "object",
          "properties": {
            "schedule": {
              "type": "string"
            }
          },
          "required": [
            "schedule"
          ],
          "description": "A cron schedule (fires `schedule` events)."
        }
      ]
    }
  }
}
