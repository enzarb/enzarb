{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "description": "Format version. Always `1`."
    },
    "id": {
      "type": "string",
      "description": "Unique id; the finding key is `<id>:<task id>` (or `<id>:<project>`)."
    },
    "kind": {
      "$ref": "#/$defs/FindingKind",
      "description": "`dead_wait` (a task waits for something that will not come) or `platform_failure`."
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "scope": {
      "$ref": "#/$defs/CheckScope",
      "description": "`task` (evaluated per open task) or `platform` (per Project).",
      "default": "task"
    },
    "text": {
      "type": "string",
      "description": "The finding text. `{task}`, `{node}`, `{phase}` and `{project}` are replaced."
    },
    "issue": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssueSpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "File one issue when the finding opens (deduplicated by `finding:<id>:<subject>`)."
    },
    "when": {
      "$ref": "#/$defs/When",
      "description": "When this holds the finding is open."
    }
  },
  "required": [
    "version",
    "id",
    "kind",
    "severity",
    "text",
    "when"
  ],
  "description": "A liveness check (`checks/*.yaml` in a library): a data-driven condition the engine's\nperiodic `platform` pass evaluates. While it holds, the engine keeps one **finding** open\nper task (or per Project for `platform` scope); when it stops holding, the finding clears.\nA finding is observation only: it never cancels, stops, restarts or times anything out.",
  "title": "CheckFile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FindingKind": {
      "type": "string",
      "enum": [
        "dead_wait",
        "platform_failure",
        "event_failing"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "CheckScope": {
      "type": "string",
      "enum": [
        "task",
        "platform"
      ]
    },
    "IssueSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Issue title. `{task}`, `{node}`, `{phase}` and `{project}` are replaced."
        },
        "body": {
          "type": "string",
          "description": "Issue body, with the same replacements."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repo": {
          "type": [
            "string",
            "null"
          ],
          "description": "`owner/name`. Defaults to the task's repo; required for `scope: platform`."
        }
      },
      "required": [
        "title",
        "body"
      ],
      "description": "The issue a check files once when its finding opens. The key is `finding:<check id>:<task\nid>` (`<project>` for `platform` scope) and never carries a time, so a finding that clears\nand returns updates the same issue instead of filing another. Nothing closes it."
    },
    "When": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/When"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "description": "Every condition holds."
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/When"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "description": "At least one condition holds."
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/When"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "description": "The condition does not hold."
        },
        {
          "type": "object",
          "properties": {
            "waiting_on": {
              "type": "string"
            }
          },
          "required": [
            "waiting_on"
          ],
          "additionalProperties": false,
          "description": "The task's `waiting_on` equals this (`external`, `human`, ...)."
        },
        {
          "type": "object",
          "properties": {
            "node": {
              "type": "string"
            }
          },
          "required": [
            "node"
          ],
          "additionalProperties": false,
          "description": "The task's current node (`phase/node`) equals this."
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string"
            }
          },
          "required": [
            "phase"
          ],
          "additionalProperties": false,
          "description": "The task's phase equals this."
        },
        {
          "type": "object",
          "properties": {
            "fact": {
              "$ref": "#/$defs/FactIs"
            }
          },
          "required": [
            "fact"
          ],
          "additionalProperties": false,
          "description": "A stored fact's value: `is: unknown` (never fetched or null), `is: false`, or any value."
        },
        {
          "type": "object",
          "properties": {
            "fact_unknown_for": {
              "$ref": "#/$defs/FactUnknownFor"
            }
          },
          "required": [
            "fact_unknown_for"
          ],
          "additionalProperties": false,
          "description": "The fact was refreshed to an unknown value at least this many times in a row."
        },
        {
          "type": "object",
          "properties": {
            "fact_count": {
              "$ref": "#/$defs/FactCount"
            }
          },
          "required": [
            "fact_count"
          ],
          "additionalProperties": false,
          "description": "A count in a fact: `name` is the fact, optionally followed by a dotted path\n(`ci.check_runs`). A list counts its items, a number is itself, an absent value is not\ncounted (the condition does not hold)."
        },
        {
          "type": "object",
          "properties": {
            "idle_for": {
              "$ref": "#/$defs/IdleFor"
            }
          },
          "required": [
            "idle_for"
          ],
          "additionalProperties": false,
          "description": "No event reached the task, and/or no step ran for it, for this long."
        },
        {
          "type": "object",
          "properties": {
            "command_ignored": {
              "$ref": "#/$defs/CommandIgnored"
            }
          },
          "required": [
            "command_ignored"
          ],
          "additionalProperties": false,
          "description": "A command (`/retry`, ...) reached the task and nothing has happened to the task since:\nno change of node or status and no effect."
        },
        {
          "type": "object",
          "properties": {
            "relation_count": {
              "$ref": "#/$defs/RelationCount"
            }
          },
          "required": [
            "relation_count"
          ],
          "additionalProperties": false,
          "description": "The number of relation rows of one kind (`blocked_by`, `parent`, `child`, ...)."
        },
        {
          "type": "object",
          "properties": {
            "platform": {
              "$ref": "#/$defs/PlatformCmp"
            }
          },
          "required": [
            "platform"
          ],
          "additionalProperties": false,
          "description": "A platform fact compared with a value (reads through the engine's provider)."
        },
        {
          "type": "object",
          "properties": {
            "platform_wait": {
              "$ref": "#/$defs/PlatformWaitIs"
            }
          },
          "required": [
            "platform_wait"
          ],
          "additionalProperties": false,
          "description": "The task is in a platform wait (ADR-0026), optionally for this failure kind."
        },
        {
          "type": "object",
          "properties": {
            "event_failing": {
              "$ref": "#/$defs/EventFailingIs"
            }
          },
          "required": [
            "event_failing"
          ],
          "additionalProperties": false,
          "description": "An inbox event of the task keeps failing (retried with backoff, ADR-0024), optionally\nfor at least this long."
        }
      ],
      "description": "A condition: combinators over leaf predicates. No scripting."
    },
    "FactIs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "is": {
          "description": "`unknown`, `false`, `true` or a literal value."
        }
      },
      "required": [
        "name",
        "is"
      ]
    },
    "FactUnknownFor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "refreshes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Consecutive unknown refreshes (at least 1)."
        }
      },
      "required": [
        "name",
        "refreshes"
      ]
    },
    "FactCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "eq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "eq"
      ]
    },
    "IdleFor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "no_event": {
          "type": [
            "string",
            "null"
          ]
        },
        "no_step": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "At least one field. A duration is `90s`, `15m`, `2h`, `14d` or `1w`."
    },
    "CommandIgnored": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "for": {
          "type": "string",
          "description": "How long ago the command arrived (`15m`)."
        },
        "command": {
          "type": [
            "string",
            "null"
          ],
          "description": "Only this command (without the slash). Any command when absent."
        }
      },
      "required": [
        "for"
      ]
    },
    "RelationCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "inbound": {
          "type": "boolean",
          "description": "Count the rows other tasks hold towards this task's subjects (an epic's `parent` rows\nnaming the sub-issue) instead of the rows this task holds itself."
        },
        "eq": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "gt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "kind"
      ],
      "description": "Exactly one of `eq` and `gt`."
    },
    "PlatformCmp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact": {
          "$ref": "#/$defs/PlatformFactName"
        },
        "op": {
          "$ref": "#/$defs/CmpOp",
          "default": "eq"
        },
        "value": true
      },
      "required": [
        "fact",
        "value"
      ]
    },
    "PlatformFactName": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "workflow_run.status",
            "chart.deploy_state",
            "sandbox.disk_pct",
            "sandbox.mem_pct",
            "project.pending_change"
          ]
        },
        {
          "type": "string",
          "const": "sandbox.healthy",
          "description": "The sandbox reported stats recently."
        }
      ],
      "description": "Platform facts the engine can read. A fact whose source is missing is unknown and never\nmatches. `chart.deploy_state` has no source yet and is always unknown."
    },
    "CmpOp": {
      "type": "string",
      "enum": [
        "eq",
        "ne",
        "gt",
        "ge",
        "lt",
        "le"
      ]
    },
    "PlatformWaitIs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "`disk_full`, `oom`, ... Any kind when absent."
        }
      }
    },
    "EventFailingIs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "for": {
          "type": [
            "string",
            "null"
          ],
          "description": "How long the event has been failing (`5m`). Immediately when absent."
        }
      }
    }
  }
}
