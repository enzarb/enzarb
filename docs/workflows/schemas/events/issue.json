{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "`opened`, `edited`, `closed`, `reopened`, …"
    },
    "number": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "action",
    "number"
  ],
  "title": "Issue",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
