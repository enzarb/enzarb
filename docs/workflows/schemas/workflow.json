{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "description": "Format version. Always `1`."
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Free text shown in the viewer."
    },
    "imports": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhaseEntry"
      },
      "description": "The phases, run in order. `done` of one phase enters the next."
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CustomEventDecl"
      },
      "description": "Custom events this workflow can wait on, by name."
    },
    "board": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reference to a board file (`std/board`). Layered over the library board."
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Param"
      },
      "description": "Typed params of the workflow, set by the binding's `with`. Phase\nentries pass them down as `{param: <name>}`."
    },
    "on": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Handler"
      },
      "description": "Task-wide handlers, tried in order on every event in any phase, wait\nor running step; the first match wins."
    }
  },
  "required": [
    "version",
    "phases"
  ],
  "description": "A workflow file: an ordered list of phases.",
  "title": "WorkflowFile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PhaseEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Unique id in this workflow. Defaults to the last segment of `use`."
        },
        "use": {
          "type": "string",
          "description": "Reference to a phase file (`std/phases/plan`, `.enzarb/phases/lint`)."
        },
        "with": {
          "type": "object",
          "additionalProperties": true,
          "description": "Values for the phase's params."
        },
        "exits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExitTo"
          },
          "description": "Where each exit goes. Unmapped `done` enters the next phase; any other\nunmapped exit ends the task with the exit name as status."
        },
        "max_entries": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumField"
            },
            {
              "type": "null"
            }
          ],
          "description": "How often the phase may be entered (default 5). A number,\n`{param: <name>}` of the workflow, or a template over `params`."
        },
        "on_limit": {
          "type": [
            "string",
            "null"
          ],
          "description": "The exit taken instead of entering the phase once more than\n`max_entries` times (default `limit_reached`)."
        }
      },
      "required": [
        "use"
      ],
      "description": "One phase of a workflow."
    },
    "ExitTo": {
      "anyOf": [
        {
          "type": "string",
          "description": "`next` (the following phase) or the id of any phase, earlier or later."
        },
        {
          "type": "object",
          "properties": {
            "end": {
              "type": "string"
            }
          },
          "required": [
            "end"
          ],
          "description": "End the task with this status."
        }
      ],
      "description": "Target of a phase exit."
    },
    "NumField": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        {
          "type": "object",
          "properties": {
            "param": {
              "type": "string"
            }
          },
          "required": [
            "param"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "An integer field: a number, `{param: <name>}`, or a string: a duration\n(`90s`, `15m`, `2h`, `14d`, `1w`, where durations are allowed) or a\ntemplate (`\"{{ params.rounds * 2 }}\"`) rendering to one."
    },
    "CustomEventDecl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "schema": {
          "description": "JSON Schema of the payload.",
          "default": {}
        }
      },
      "required": [
        "description"
      ],
      "description": "Declaration of a custom event (ADR-0022 §5)."
    },
    "Param": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ParamType"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "description": "Value used when the caller gives none. A param without a default is required."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed values of an `enum` param."
        },
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParamType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Item type of a `list` param (default `string`)."
        }
      },
      "required": [
        "type"
      ],
      "description": "A typed parameter of a phase or step file."
    },
    "ParamType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "boolean"
          ]
        },
        {
          "type": "string",
          "const": "prompt",
          "description": "A MiniJinja prompt template: inline text or `{file: path}`."
        },
        {
          "type": "string",
          "const": "command",
          "description": "A shell command line."
        },
        {
          "type": "string",
          "const": "enum",
          "description": "One of `values`."
        },
        {
          "type": "string",
          "const": "list",
          "description": "A list of `items`."
        }
      ]
    },
    "Handler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Matcher"
          },
          "description": "Events that trigger the handler (same matchers as a wait)."
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sender"
            },
            {
              "type": "null"
            }
          ],
          "description": "Default sender requirement for matchers without `from` (default `anyone`)."
        },
        "if": {
          "type": [
            "string",
            "null"
          ],
          "description": "Extra condition (an expression; `event` is the candidate)."
        },
        "set": {
          "type": "object",
          "additionalProperties": true,
          "description": "Task variables assigned when the handler fires (see node `set`)."
        },
        "do": {
          "type": [
            "string",
            "null"
          ],
          "description": "What to do: `cancel` (end with status `cancelled`), `end:<status>`,\n`goto:<phase id>` or `stop_step`. Without `do` the handler only\nassigns `set` and the event is still offered to the step or wait."
        }
      },
      "required": [
        "events"
      ],
      "description": "A task-wide event handler (`on:` of a workflow)."
    },
    "Matcher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/MatcherSpec"
        }
      ],
      "description": "An event matcher: a type name, or a type with a sender requirement and condition."
    },
    "MatcherSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string"
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sender"
            },
            {
              "type": "null"
            }
          ]
        },
        "if": {
          "type": [
            "string",
            "null"
          ],
          "description": "MiniJinja expression over the task document; `event` is the candidate."
        }
      },
      "required": [
        "event"
      ]
    },
    "Sender": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "anyone"
          ]
        },
        {
          "type": "string",
          "const": "writer",
          "description": "The actor must have write access (`actor.can_write`, supplied by the engine)."
        }
      ],
      "description": "Required sender of an event."
    }
  }
}
