{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "imports": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Param"
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Exit names besides the implicit `done` and `limit_reached`."
    },
    "start": {
      "type": "string",
      "description": "The first node."
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Node"
      }
    }
  },
  "required": [
    "version",
    "start",
    "nodes"
  ],
  "description": "A phase file: a subgraph with typed params, named exits and private nodes.",
  "title": "PhaseFile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Param": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ParamType"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "description": "Value used when the caller gives none. A param without a default is required."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed values of an `enum` param."
        },
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParamType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Item type of a `list` param (default `string`)."
        }
      },
      "required": [
        "type"
      ],
      "description": "A typed parameter of a phase or step file."
    },
    "ParamType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "boolean"
          ]
        },
        {
          "type": "string",
          "const": "prompt",
          "description": "A MiniJinja prompt template: inline text or `{file: path}`."
        },
        {
          "type": "string",
          "const": "command",
          "description": "A shell command line."
        },
        {
          "type": "string",
          "const": "enum",
          "description": "One of `values`."
        },
        {
          "type": "string",
          "const": "list",
          "description": "A list of `items`."
        }
      ]
    },
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepUse"
            },
            {
              "type": "null"
            }
          ],
          "description": "Runs a step in the sandbox."
        },
        "wait": {
          "anyOf": [
            {
              "$ref": "#/$defs/Wait"
            },
            {
              "type": "null"
            }
          ],
          "description": "Waits for events."
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/Action"
            },
            {
              "type": "null"
            }
          ],
          "description": "Calls a generic connector action."
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/End"
            },
            {
              "type": "null"
            }
          ],
          "description": "Leaves the phase through the exit named `status`."
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseUse"
            },
            {
              "type": "null"
            }
          ],
          "description": "Runs a nested phase; its exit is `exit` in the edge conditions."
        },
        "decide": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decide"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pure branching: no effect, `next` is followed as soon as the node is entered."
        },
        "set": {
          "type": "object",
          "additionalProperties": true,
          "description": "Task variables assigned on entry, in order: `name: <expression>`\n(strings are expressions; other YAML values and `{param: x}` are\nliterals). Stored in `vars`. A node with only `set` and `next` is a\ndecide node."
        },
        "set_on_exit": {
          "type": "object",
          "additionalProperties": true,
          "description": "Task variables assigned when the node is left, after its edge was\nchosen (`last`, `exit` and, at a wait, `event` are in scope)."
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/Next"
            },
            {
              "type": "null"
            }
          ],
          "description": "The next node. Not allowed on `end`."
        },
        "max_visits": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumField"
            },
            {
              "type": "null"
            }
          ],
          "description": "How often this node may be entered per phase entry (default 10). A\nnumber, `{param: <name>}`, or a template over `params`."
        },
        "on_limit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Node entered instead once `max_visits` is exceeded. Without it the\nphase exits with `limit_reached`."
        }
      },
      "description": "A node: exactly one of `step`, `wait`, `action`, `end`, `phase`, plus edges."
    },
    "StepUse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use": {
          "type": [
            "string",
            "null"
          ]
        },
        "inline": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepFile"
            },
            {
              "type": "null"
            }
          ],
          "description": "An inline step (instead of `use`)."
        },
        "with": {
          "type": "object",
          "additionalProperties": true,
          "description": "Param values. `{param: name}` passes a param of the enclosing phase."
        }
      },
      "description": "Use of a step file, or an inline step definition."
    },
    "StepFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "imports": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Param"
          }
        },
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Agent"
            },
            {
              "type": "null"
            }
          ],
          "description": "An agent step (exactly one of `agent` and `command`)."
        },
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/Command"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Input"
          },
          "description": "Named template variables taken from the task document."
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Output"
          },
          "description": "Output files collected after the step."
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Structured result submitted through the `submit_result` tool."
        },
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Workspace"
          },
          "description": "Extra workspaces besides the task's primary one."
        },
        "github": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Access"
          },
          "description": "GitHub token permissions (`contents: write`)."
        },
        "secrets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretDecl"
          },
          "description": "Secrets injected into this step's process: a bare name (project\nscope, env var of that name) or `{name, scope, env | file}`."
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "concurrency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Concurrency"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Retry"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform_wait": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlatformWaitRule"
          },
          "description": "Environment failures (`step_finished.environment.kind`) the task waits out instead of\nrouting on: no retry budget, no timeout. The step resumes on the same run when `until`\nholds (ADR-0026). A kind not listed behaves as before."
        },
        "steer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Matcher"
          },
          "description": "Events delivered into the running agent session as user turns."
        },
        "stop": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Matcher"
          },
          "description": "Events that stop the running step (it then finishes with exit\n`interrupted`). Default: a `stop` command from a writer."
        }
      },
      "description": "A step file: one unit of work in the sandbox, an agent or a command."
    },
    "Agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string",
          "description": "Reference to a runtime file."
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextField"
            },
            {
              "type": "null"
            }
          ],
          "description": "Model name (text field: `{param: x}` or a template)."
        },
        "prompt": {
          "$ref": "#/$defs/Source",
          "description": "MiniJinja prompt template."
        }
      },
      "required": [
        "runtime",
        "prompt"
      ]
    },
    "TextField": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "param": {
              "type": "string"
            }
          },
          "required": [
            "param"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "A text field: a string (a MiniJinja template when it contains `{{`/`{%`)\nor `{param: <name>}`."
    },
    "Source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ]
        },
        {
          "type": "object",
          "properties": {
            "param": {
              "type": "string"
            }
          },
          "required": [
            "param"
          ]
        }
      ],
      "description": "A value that is either given inline, read from a file in the referencing\nrepository, or taken from a param of the enclosing file."
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/Source",
          "description": "Shell command line (a MiniJinja template)."
        },
        "tools": {
          "$ref": "#/$defs/Tools"
        }
      },
      "required": [
        "run"
      ]
    },
    "Tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mise": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "mise tool specs installed before the step (`node@22`)."
        }
      }
    },
    "Input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "description": "Dotted path into the task document (`outputs.plan`, `subjects.issue.body`)."
        },
        "type": {
          "$ref": "#/$defs/InputType",
          "default": "any"
        },
        "required": {
          "type": "boolean",
          "description": "When true (default) a missing value pauses the task instead of rendering.",
          "default": true
        },
        "default": true
      },
      "required": [
        "from"
      ],
      "description": "A typed reference into the task document."
    },
    "InputType": {
      "type": "string",
      "enum": [
        "any",
        "string",
        "integer",
        "number",
        "boolean",
        "object",
        "list"
      ]
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "description": "Path in the workspace, read after the step finishes."
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ],
          "description": "When set, the file is also kept as an artifact with this title."
        },
        "format": {
          "type": [
            "string",
            "null"
          ],
          "description": "`markdown`, `json` (parsed) or `text`. Default from the extension."
        },
        "optional": {
          "type": "boolean",
          "description": "A missing optional file is not an error."
        }
      },
      "required": [
        "file"
      ]
    },
    "ResultSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "description": "JSON Schema of the result (the `submit_result` tool's input)."
        },
        "as": {
          "type": [
            "string",
            "null"
          ],
          "description": "Output name the result is stored under (default: the node id)."
        }
      },
      "required": [
        "schema"
      ]
    },
    "Workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "description": "`owner/repo`; a template."
        },
        "mode": {
          "$ref": "#/$defs/Access"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "description": "Branch to work on and push (write workspaces only; a template)."
        },
        "base": {
          "type": [
            "string",
            "null"
          ],
          "description": "Base ref to branch from or check out (a template)."
        }
      },
      "required": [
        "repo",
        "mode"
      ]
    },
    "Access": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ]
    },
    "SecretDecl": {
      "anyOf": [
        {
          "type": "string",
          "description": "Project scope, injected as the env var `NAME`."
        },
        {
          "$ref": "#/$defs/Secret"
        }
      ],
      "description": "A named secret as written: `NAME` or `{name, scope, env | file}`."
    },
    "Secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SecretScope",
          "default": "project"
        },
        "env": {
          "type": [
            "string",
            "null"
          ],
          "description": "Environment variable to set."
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "File (relative to the workspace root) to write the value to."
        }
      },
      "required": [
        "name"
      ],
      "description": "A secret: where it is stored and how the process receives it."
    },
    "SecretScope": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "project",
            "instance"
          ]
        },
        {
          "type": "string",
          "const": "user",
          "description": "The user the step acts for."
        }
      ]
    },
    "Concurrency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string",
          "description": "Group key (a template, e.g. `{{ task.repo }}`)."
        },
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "group",
        "max"
      ]
    },
    "Retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Extra attempts."
        },
        "on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Exits that are retried (default `failure`)."
        }
      },
      "required": [
        "max"
      ]
    },
    "PlatformWaitRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "`disk_full`, `oom`, `network` or `load`."
        },
        "until": {
          "$ref": "#/$defs/When",
          "description": "The wake condition: `platform` leaves under `all`/`any`/`not` (the `checks/*.yaml`\nvocabulary). An unknown fact keeps the task waiting."
        }
      },
      "required": [
        "kind",
        "until"
      ],
      "description": "One `platform_wait` entry: wait on this failure kind until the condition holds."
    },
    "When": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/When"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "description": "Every condition holds."
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/When"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "description": "At least one condition holds."
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/When"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "description": "The condition does not hold."
        },
        {
          "type": "object",
          "properties": {
            "waiting_on": {
              "type": "string"
            }
          },
          "required": [
            "waiting_on"
          ],
          "additionalProperties": false,
          "description": "The task's `waiting_on` equals this (`external`, `human`, ...)."
        },
        {
          "type": "object",
          "properties": {
            "node": {
              "type": "string"
            }
          },
          "required": [
            "node"
          ],
          "additionalProperties": false,
          "description": "The task's current node (`phase/node`) equals this."
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string"
            }
          },
          "required": [
            "phase"
          ],
          "additionalProperties": false,
          "description": "The task's phase equals this."
        },
        {
          "type": "object",
          "properties": {
            "fact": {
              "$ref": "#/$defs/FactIs"
            }
          },
          "required": [
            "fact"
          ],
          "additionalProperties": false,
          "description": "A stored fact's value: `is: unknown` (never fetched or null), `is: false`, or any value."
        },
        {
          "type": "object",
          "properties": {
            "fact_unknown_for": {
              "$ref": "#/$defs/FactUnknownFor"
            }
          },
          "required": [
            "fact_unknown_for"
          ],
          "additionalProperties": false,
          "description": "The fact was refreshed to an unknown value at least this many times in a row."
        },
        {
          "type": "object",
          "properties": {
            "fact_count": {
              "$ref": "#/$defs/FactCount"
            }
          },
          "required": [
            "fact_count"
          ],
          "additionalProperties": false,
          "description": "A count in a fact: `name` is the fact, optionally followed by a dotted path\n(`ci.check_runs`). A list counts its items, a number is itself, an absent value is not\ncounted (the condition does not hold)."
        },
        {
          "type": "object",
          "properties": {
            "idle_for": {
              "$ref": "#/$defs/IdleFor"
            }
          },
          "required": [
            "idle_for"
          ],
          "additionalProperties": false,
          "description": "No event reached the task, and/or no step ran for it, for this long."
        },
        {
          "type": "object",
          "properties": {
            "command_ignored": {
              "$ref": "#/$defs/CommandIgnored"
            }
          },
          "required": [
            "command_ignored"
          ],
          "additionalProperties": false,
          "description": "A command (`/retry`, ...) reached the task and nothing has happened to the task since:\nno change of node or status and no effect."
        },
        {
          "type": "object",
          "properties": {
            "relation_count": {
              "$ref": "#/$defs/RelationCount"
            }
          },
          "required": [
            "relation_count"
          ],
          "additionalProperties": false,
          "description": "The number of relation rows of one kind (`blocked_by`, `parent`, `child`, ...)."
        },
        {
          "type": "object",
          "properties": {
            "platform": {
              "$ref": "#/$defs/PlatformCmp"
            }
          },
          "required": [
            "platform"
          ],
          "additionalProperties": false,
          "description": "A platform fact compared with a value (reads through the engine's provider)."
        },
        {
          "type": "object",
          "properties": {
            "platform_wait": {
              "$ref": "#/$defs/PlatformWaitIs"
            }
          },
          "required": [
            "platform_wait"
          ],
          "additionalProperties": false,
          "description": "The task is in a platform wait (ADR-0026), optionally for this failure kind."
        }
      ],
      "description": "A condition: combinators over leaf predicates. No scripting."
    },
    "FactIs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "is": {
          "description": "`unknown`, `false`, `true` or a literal value."
        }
      },
      "required": [
        "name",
        "is"
      ]
    },
    "FactUnknownFor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "refreshes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Consecutive unknown refreshes (at least 1)."
        }
      },
      "required": [
        "name",
        "refreshes"
      ]
    },
    "FactCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "eq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "eq"
      ]
    },
    "IdleFor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "no_event": {
          "type": [
            "string",
            "null"
          ]
        },
        "no_step": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "At least one field. A duration is `90s`, `15m`, `2h`, `14d` or `1w`."
    },
    "CommandIgnored": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "for": {
          "type": "string",
          "description": "How long ago the command arrived (`15m`)."
        },
        "command": {
          "type": [
            "string",
            "null"
          ],
          "description": "Only this command (without the slash). Any command when absent."
        }
      },
      "required": [
        "for"
      ]
    },
    "RelationCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "inbound": {
          "type": "boolean",
          "description": "Count the rows other tasks hold towards this task's subjects (an epic's `parent` rows\nnaming the sub-issue) instead of the rows this task holds itself."
        },
        "eq": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "gt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "kind"
      ],
      "description": "Exactly one of `eq` and `gt`."
    },
    "PlatformCmp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact": {
          "$ref": "#/$defs/PlatformFactName"
        },
        "op": {
          "$ref": "#/$defs/CmpOp",
          "default": "eq"
        },
        "value": true
      },
      "required": [
        "fact",
        "value"
      ]
    },
    "PlatformFactName": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "workflow_run.status",
            "chart.deploy_state",
            "sandbox.disk_pct",
            "sandbox.mem_pct",
            "project.pending_change"
          ]
        },
        {
          "type": "string",
          "const": "sandbox.healthy",
          "description": "The sandbox reported stats recently."
        }
      ],
      "description": "Platform facts the engine can read. A fact whose source is missing is unknown and never\nmatches. `chart.deploy_state` has no source yet and is always unknown."
    },
    "CmpOp": {
      "type": "string",
      "enum": [
        "eq",
        "ne",
        "gt",
        "ge",
        "lt",
        "le"
      ]
    },
    "PlatformWaitIs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "`disk_full`, `oom`, ... Any kind when absent."
        }
      }
    },
    "Matcher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/MatcherSpec"
        }
      ],
      "description": "An event matcher: a type name, or a type with a sender requirement and condition."
    },
    "MatcherSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string"
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sender"
            },
            {
              "type": "null"
            }
          ]
        },
        "if": {
          "type": [
            "string",
            "null"
          ],
          "description": "MiniJinja expression over the task document; `event` is the candidate."
        }
      },
      "required": [
        "event"
      ]
    },
    "Sender": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "anyone"
          ]
        },
        {
          "type": "string",
          "const": "writer",
          "description": "The actor must have write access (`actor.can_write`, supplied by the engine)."
        }
      ],
      "description": "Required sender of an event."
    },
    "Wait": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Matcher"
          },
          "description": "Event types that can satisfy the wait (catalog types, declared custom\nevents, `timer`, or `fact`)."
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sender"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who may send them (default `anyone`); applies to every matcher that sets no `from`."
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextField"
            },
            {
              "type": "null"
            }
          ],
          "description": "Machine-readable wait reason shown in the projection (text field)."
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextField"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human text (a MiniJinja template, or `{param: x}`)."
        },
        "column": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextField"
            },
            {
              "type": "null"
            }
          ],
          "description": "Board column id while waiting here (text field)."
        },
        "waiting_on": {
          "anyOf": [
            {
              "$ref": "#/$defs/WaitingOn"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who the task waits on. Default: `human` if the wait has actions or\nrequires a writer, else `external`."
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UiActionSpec"
          },
          "description": "UI buttons; each posts its `/command` as the clicking user."
        },
        "steer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Matcher"
          },
          "description": "Events forwarded into the task's last agent session while waiting."
        },
        "refresh": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Facts refreshed when the wait is entered."
        },
        "timer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timer"
            },
            {
              "type": "null"
            }
          ],
          "description": "A timer set when the wait is entered; it fires a `timer` event."
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandDecl"
          },
          "description": "Commands this wait accepts besides the workflow's defaults (same name overrides).\nResolved: the full list, defaults and commands its `next:` rules match included."
        }
      },
      "required": [
        "events"
      ],
      "description": "A wait node (engine side)."
    },
    "WaitingOn": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "external"
      ]
    },
    "UiActionSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/TextField"
        },
        "command": {
          "$ref": "#/$defs/TextField",
          "description": "Command word posted as `/command` (without the slash)."
        }
      },
      "required": [
        "label",
        "command"
      ],
      "description": "A UI button as declared at a wait: `label` and `command` are text fields."
    },
    "Timer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "$ref": "#/$defs/NumField",
          "description": "Seconds, a duration (`14d`), `{param: x}`, or a template. A template\nthat reads more than `params` is rendered on entry."
        }
      },
      "required": [
        "seconds"
      ]
    },
    "NumField": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        {
          "type": "object",
          "properties": {
            "param": {
              "type": "string"
            }
          },
          "required": [
            "param"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "An integer field: a number, `{param: <name>}`, or a string: a duration\n(`90s`, `15m`, `2h`, `14d`, `1w`, where durations are allowed) or a\ntemplate (`\"{{ params.rounds * 2 }}\"`) rendering to one."
    },
    "CommandDecl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/TextField",
          "description": "The command word without the slash (a text field: `{param: approve_command}`)."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextField"
            },
            {
              "type": "null"
            }
          ],
          "description": "Button and list label (default: the command)."
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextField"
            },
            {
              "type": "null"
            }
          ],
          "description": "One line for the UI and the reply to a command that does not apply."
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sender"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who may send it (default `writer`)."
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "description": "The route, see above."
        }
      },
      "required": [
        "name"
      ],
      "description": "A command (`/name` in a comment, or a UI button) a wait accepts.\n\n`to` is where the command goes: a node of the wait's phase, `exit:<name>` (leave the phase\nthrough that exit), `start` (the phase's first node), `self` (this wait again) or\n`goto:<phase id>` (enter a top-level phase). Without `to` the wait's own `next:` rules\nroute the command; the declaration only lists it. `/cancel` is engine-native."
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Connector action name."
        },
        "args": {
          "type": "object",
          "additionalProperties": true,
          "description": "Arguments: any YAML. String leaves are MiniJinja templates; a leaf\nthat is exactly one `{{ expr }}` keeps the expression's JSON type;\n`{param: x}` is the param's value."
        },
        "relate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Relate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Task relations: `targets` (evaluated before the call) or `from`\n(evaluated over the call's `result`)."
        },
        "as": {
          "type": [
            "string",
            "null"
          ],
          "description": "Stores a successful call's result as `outputs.<as>`."
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectLink"
            },
            {
              "type": "null"
            }
          ],
          "description": "Links the GitHub object the call returned as a subject of the task:\n`true` reads `kind`, `number` and `repo` from the result, or give\n`{kind, number, repo}` (`number`/`repo` are expressions over `result`)."
        }
      },
      "required": [
        "name"
      ],
      "description": "A generic connector call made by the engine."
    },
    "Relate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "targets": {
          "type": [
            "string",
            "null"
          ],
          "description": "Expression yielding a list, evaluated before the call."
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "description": "Expression over the call's `result` (and the document) yielding a\ntarget or a list of them, evaluated after a successful call."
        }
      },
      "required": [
        "kind"
      ],
      "description": "Relations to create. Exactly one of `targets` and `from`."
    },
    "SubjectLink": {
      "anyOf": [
        {
          "type": "boolean",
          "description": "`true`: the result has `kind` (`issue`/`pull_request`), `number` and optionally `repo`."
        },
        {
          "$ref": "#/$defs/SubjectSpec"
        }
      ],
      "description": "How an action's result becomes a linked subject."
    },
    "SubjectSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/SubjectKind"
        },
        "number": {
          "type": [
            "string",
            "null"
          ],
          "description": "Expression over `result` (default `result.number`)."
        },
        "repo": {
          "type": [
            "string",
            "null"
          ],
          "description": "Expression over `result` (default `result.repo`, else `task.repo`)."
        }
      },
      "required": [
        "kind"
      ]
    },
    "SubjectKind": {
      "type": "string",
      "enum": [
        "issue",
        "pull_request"
      ]
    },
    "End": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "description": "The exit name (inside a phase); for the task, its end status."
        }
      },
      "required": [
        "status"
      ]
    },
    "PhaseUse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use": {
          "type": "string"
        },
        "with": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "use"
      ],
      "description": "Use of a nested phase file."
    },
    "Decide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Free text shown in the viewer."
        }
      },
      "description": "A decide node: no effect, only edges."
    },
    "Next": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Branch"
          }
        }
      ],
      "description": "Edges: a node id, or ordered branches where the first true `if` wins."
    },
    "Branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "if": {
          "type": [
            "string",
            "null"
          ],
          "description": "A MiniJinja expression over the task document."
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "else": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "`{if: <expression>, to: <node>}` or a final `{else: <node>}`."
    }
  }
}
