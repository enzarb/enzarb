{
	"name": "enzarb-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "vite preview",
		"proto:build": "npm --prefix ../proto ci --ignore-scripts && npm --prefix ../proto run build",
		"prepare": "npm run proto:build && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"brand": "node scripts/build-brand.mjs",
		"icons": "node scripts/generate-icons.mjs",
		"migrate": "node scripts/migrate.ts",
		"test:e2e": "playwright test",
		"test:e2e:prod": "vite build --config vite.e2e.config.ts && E2E_PROD=1 playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testcontainers/postgresql": "^12.2.0",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.2",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"png-to-ico": "^3.0.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass": "^1.105.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^1.8.0",
		"@enzarb/proto": "file:../proto",
		"@kubernetes/client-node": "^2.0.0",
		"@types/web-push": "^3.6.4",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"arctic": "^3.7.0",
		"bits-ui": "2.19.5",
		"jose": "^6.2.12",
		"marked": "^18.1.0",
		"postgres": "^3.4.9",
		"sanitize-html": "^2.18.0",
		"valibot": "^1.5.0",
		"web-push": "^3.6.7"
	}
}
