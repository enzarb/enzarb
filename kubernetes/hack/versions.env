# Single source of truth for pinned upstream versions.
# Remote-URL bases (cert-manager, envoy-gateway, agent-sandbox) must be bumped
# by hand in their kustomization.yaml to match; vendored bases (capsule,
# capsule-proxy, pgop) are regenerated by hack/refresh-vendored.sh.
CERT_MANAGER_VERSION=v1.21.2
ENVOY_GATEWAY_VERSION=v1.9.2
AGENT_SANDBOX_VERSION=v0.5.6
CAPSULE_CHART_VERSION=0.14.6        # app v0.14.6
CAPSULE_PROXY_CHART_VERSION=0.15.0  # app v0.15.0
PGOP_CHART_VERSION=0.9.1            # app v0.9.1 (oci://ghcr.io/ruckc/charts/pgop)
HELM_VERSION=v4.3.0
# gVisor (hack/kind-install-gvisor.sh and, as build args, installer/Dockerfile via CI). Release tarball from
# github.com/google/gvisor/releases; sha512 of gvisor-<arch>.tar.bz2 from the release SHA512SUMS.
GVISOR_VERSION=20261005.0
GVISOR_SHA512_X86_64=79869ae9a589355a46d46fdac068d9a954e741741ffe77c64e38c56ea955498c1cb04e9bce44e1cce5155333e6b76bee72347c6661bb7c78fd2fe3aad198c8fe
GVISOR_SHA512_AARCH64=1bc58be6f881264ced1df8ff61db0205531abedcace005585ac5637c5c987831062b365f99f270ef0939849f130344b84e0f1a663294406f798b8f7c8cd326ac
# oldie single-node install (rke2/ Ansible role, base/openebs-lvm).
RKE2_VERSION=v1.35.9+rke2r1
OPENEBS_LVM_VERSION=v1.10.1         # manifest tag; driver image openebs/lvm-driver:1.10.1
CLOUDFLARED_VERSION=2026.10.0       # docker.io/cloudflare/cloudflared, base/cloudflared
