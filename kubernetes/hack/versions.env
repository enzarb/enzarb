# Single source of truth for pinned upstream versions.
# Remote-URL bases (cert-manager, envoy-gateway, agent-sandbox) must be bumped
# by hand in their kustomization.yaml to match; vendored bases (capsule,
# capsule-proxy, pgop) are regenerated by hack/refresh-vendored.sh.
CERT_MANAGER_VERSION=v1.21.2
ENVOY_GATEWAY_VERSION=v1.9.2
AGENT_SANDBOX_VERSION=v0.5.6
CAPSULE_CHART_VERSION=0.14.6        # app v0.14.6
CAPSULE_PROXY_CHART_VERSION=0.15.0  # app v0.15.0
PGOP_CHART_VERSION=0.9.1            # app v0.9.1 (oci://ghcr.io/ruckc/charts/pgop)
HELM_VERSION=v4.3.0
