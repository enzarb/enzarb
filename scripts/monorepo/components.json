{
  "rust_root_files": ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml"],
  "crate_granular": [],
  "docker_extra_dirs": ["proto/vectors", "operator/deploy"],
  "components": {
    "proto": {
      "image": null,
      "workflow_files": [".github/workflows/ci-proto.yml", ".github/workflows/_changes.yml", ".github/actions/setup-node/**"]
    },
    "operator": {
      "image": "enzarb-sandbox-operator", "context": "operator", "smoke": null, "timeout": 30,
      "workflow_files": [".github/workflows/ci-operator.yml", ".github/workflows/_changes.yml", ".github/workflows/_rust.yml", ".github/workflows/_docker.yml"]
    },
    "connectors": {
      "image": "enzarb-connectors-receiver", "context": ".", "smoke": null, "timeout": 30,
      "workflow_files": [".github/workflows/ci-connectors.yml", ".github/workflows/_changes.yml", ".github/workflows/_rust.yml", ".github/workflows/_docker.yml"]
    },
    "realtime": {
      "image": "enzarb-realtime", "context": ".", "smoke": null, "timeout": 30,
      "workflow_files": [".github/workflows/ci-realtime.yml", ".github/workflows/_changes.yml", ".github/workflows/_rust.yml", ".github/workflows/_docker.yml"]
    },
    "sandbox-proxy": {
      "image": "enzarb-sandbox-proxy", "context": ".", "smoke": null, "timeout": 30,
      "workflow_files": [".github/workflows/ci-sandbox-proxy.yml", ".github/workflows/_changes.yml", ".github/workflows/_rust.yml", ".github/workflows/_docker.yml"]
    },
    "sandbox-container": {
      "image": "enzarb-sandbox", "context": ".", "smoke": "scripts/smoke.sh", "timeout": 40,
      "extra_inputs": ["ui/pnpm-lock.yaml", "ez/crates/**"],
      "workflow_files": [".github/workflows/ci-sandbox-container.yml", ".github/workflows/_changes.yml", ".github/workflows/_rust.yml", ".github/workflows/_docker.yml", ".github/actions/setup-node/**"]
    },
    "ui": {
      "image": "enzarb-ui", "context": ".", "smoke": null, "timeout": 20,
      "docker_npm_src": {"proto": ["ts"]},
      "extra_inputs": ["connectors/bin/receiver/migrations/**"],
      "workflow_files": [".github/workflows/ci-ui.yml", ".github/workflows/_changes.yml", ".github/workflows/_docker.yml", ".github/actions/ui-install/**", ".github/actions/setup-node/**"]
    },
    "updater": {
      "image": "enzarb-updater", "context": ".", "smoke": null, "timeout": 30,
      "workflow_files": [".github/workflows/ci-updater.yml", ".github/workflows/_changes.yml", ".github/workflows/_rust.yml", ".github/workflows/_docker.yml"]
    },
    "ez": {
      "image": null,
      "workflow_files": [".github/workflows/ci-ez.yml", ".github/workflows/_changes.yml", ".github/workflows/_rust.yml"]
    },
    "kubernetes": {
      "image": null,
      "extra_inputs": ["mise.toml", "mise.*.toml"],
      "workflow_files": [".github/workflows/ci-kubernetes.yml", ".github/workflows/_changes.yml"]
    },
    "helm": {
      "image": null,
      "extra_inputs": ["mise.toml"],
      "workflow_files": [".github/workflows/ci-helm.yml", ".github/workflows/_changes.yml"]
    },
    "monorepo": {
      "pseudo": true,
      "globs": ["scripts/**", ".mise/tasks/**", ".mise/lib/**", ".github/workflows/**", "Cargo.toml", "Cargo.lock", "**/Cargo.toml", "**/package.json", "mise.toml", "mise.*.toml", "*/mise.toml", "*/Dockerfile", "rust-toolchain.toml", "kubernetes/hack/versions.env"]
    },
    "release-path": {
      "pseudo": true,
      "globs": [".github/scripts/**", ".github/workflows/release.yml", ".github/workflows/_release-*.yml", ".github/workflows/rebuild-all.yml", ".github/workflows/ci-release-path.yml", "scripts/monorepo/components.json", "scripts/monorepo/graph.generated.sh", "scripts/monorepo/gen-graph.sh", "scripts/monorepo/test-retag-or-build.sh", "scripts/monorepo/next-version-diff.sh", "scripts/monorepo/test-next-version-diff.sh", "scripts/monorepo/fixtures/**", "mise.toml"]
    }
  }
}
