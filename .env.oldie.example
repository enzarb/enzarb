# Create .env.oldie with `mise run oldie:init-env` (mode 600, gitignored; it also generates the webhook
# secret) and fill in the rest. See docs/oldie.md.

# One GitHub App (docs/oldie.md): webhooks, bot access and UI login.
#   webhook URL   https://enzarb.dev/hooks/github
#   callback URL  https://enzarb.dev/login/github/callback
# GITHUB_WEBHOOK_SECRET is generated by `mise run oldie:init-env`.
# GITHUB_OAUTH_CLIENT_ID/SECRET are the App's Client ID and a Client secret (not the App ID).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=~/.config/enzarb/app-private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Cloudflare DNS-01 for Let's Encrypt. Preferred: leave CLOUDFLARE_API_TOKEN empty and run
#   CLOUDFLARE_BOOTSTRAP_TOKEN=... mise run oldie:cloudflare-token
# (a token with User > API Tokens > Edit; it mints a token scoped to enzarb.dev and stores it in
# the cluster, never on disk). Or set a ready-made token here (Zone:DNS:Edit + Zone:Zone:Read on
# the enzarb.dev zone):
CLOUDFLARE_API_TOKEN=

# Read credential for the private ghcr.io/enzarb/* images and chart. Written to the node's registries.yaml
# (image pulls) and, by oldie:secrets, to the chart-pull Secrets (helm-controller and enzarb-updater).
# (a GitHub user and a token with read:packages).
GHCR_USER=
GHCR_TOKEN=

# Optional: initial chart version for oldie:bootstrap-helmchart (X.Y.Z). Unset = newest published
# chart. An existing HelmChart is never lowered; enzarb-updater owns the version after bootstrap.
# ENZARB_CHART_VERSION=
