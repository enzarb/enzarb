# Copy to .env.dev (gitignored) and fill in. See docs/dev.md.

# GitHub App (created from docs/github-app.yml)
GITHUB_APP_ID=
# Path to the App's downloaded private key (.pem file), not its contents
GITHUB_APP_PRIVATE_KEY=~/.config/enzarb/app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# Separate GitHub OAuth App for UI login; callback https://enzarb.local/login/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# smee.io channel URL used as the App's webhook URL (dev:webhook-relay)
SMEE_URL=
