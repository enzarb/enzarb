#!/usr/bin/env bash
#MISE description="helm upgrade --install enzarb on oldie at the release versions pinned in the chart (idempotent)"
set -euo pipefail
# shellcheck source=/dev/null
. "${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd)}/.mise/lib/oldie.sh"
need helm kubectl
load_oldie_env
cluster_reachable || die "cannot reach $KCTX with $KUBECONFIG; run: mise run oldie:host"
k -n "$NS" get secret enzarb-github >/dev/null 2>&1 || die "Secret $NS/enzarb-github missing; run: mise run oldie:secrets"

if [ -n "${ENZARB_CHART_VERSION:-}" ]; then
  [ -n "${GHCR_TOKEN:-}" ] && echo "$GHCR_TOKEN" | helm registry login ghcr.io -u "${GHCR_USER:?GHCR_USER}" --password-stdin >/dev/null
  chart="oci://ghcr.io/enzarb/charts/enzarb"
  vals=(--version "$ENZARB_CHART_VERSION")
  # values-oldie.yaml is not part of the published chart (.helmignore); it comes from the checkout, so
  # check out the enzarb-helm commit that matches ENZARB_CHART_VERSION.
  values_file="$ROOT/enzarb-helm/enzarb/values-oldie.yaml"
  [ -f "$values_file" ] || die "$values_file missing; run: mise run repos:init"
else
  chart="$ROOT/enzarb-helm/enzarb"
  [ -d "$chart" ] || die "$chart missing; run: mise run repos:init"
  vals=()
  values_file="$chart/values-oldie.yaml"
fi
# Helm installs crds/ only on first install and never upgrades them, so apply the chart's CRDs
# explicitly (server-side, idempotent) before upgrading.
log "CRDs from the chart"
if [ -n "${ENZARB_CHART_VERSION:-}" ]; then
  helm show crds "$chart" "${vals[@]}" | kapply -f -
else
  kapply -f "$chart/crds/"
fi
log "helm upgrade --install $RELEASE ($chart)"
helm --kube-context "$KCTX" upgrade --install "$RELEASE" "$chart" "${vals[@]}" -n "$NS" --create-namespace \
  -f "$values_file" --wait --timeout 20m

log "what is up"
echo "-- pods";            k -n "$NS" get pods
echo "-- migration jobs";  k -n "$NS" get jobs
echo "-- pgop cluster";    k -n "$NS" get clusters.pgop.ruck.io 2>/dev/null || true
echo "-- volumes";         k get pvc -A
echo "-- routes";          k -n "$NS" get httproute
echo "-- gateway";         k -n enzarb-system get gateway enzarb
echo "-- certificate";     k -n enzarb-system get certificate enzarb-tls
cat <<MSG

Checklist
  [ ] all pods above Running/Completed
  [ ] $PUBLIC_HOST is a proxied CNAME to the Cloudflare Tunnel and both pods in namespace cloudflared are Ready
  [ ] https://$PUBLIC_HOST/ loads with a Let's Encrypt certificate
  [ ] GitHub App webhook URL is https://$PUBLIC_HOST/hooks/github (Recent deliveries show 2xx)
Next: docs/dev.md ("Create the first Project").
MSG
