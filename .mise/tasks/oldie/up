#!/usr/bin/env bash
#MISE description="Bootstrap oldie: host (RKE2, gVisor, LVM), secrets, cluster prerequisites, the enzarb HelmChart. Safe to re-run; upgrades are enzarb-updater, not this"
set -euo pipefail
# shellcheck source=/dev/null
. "${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd)}/.mise/lib/oldie.sh"
cd "$ROOT"
load_oldie_env
mise run oldie:host
if [ -n "${CLOUDFLARE_BOOTSTRAP_TOKEN:-}" ]; then mise run oldie:cloudflare-token; fi
mise run oldie:secrets
mise run oldie:cluster
mise run oldie:bootstrap-helmchart
