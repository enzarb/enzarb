#!/usr/bin/env bash
#MISE description="Create the enzarb-github Secret (namespace enzarb) and cloudflare-api-token (cert-manager) from .env.oldie (idempotent)"
set -euo pipefail
# shellcheck source=/dev/null
. "${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd)}/.mise/lib/oldie.sh"
need kubectl
require_oldie_env GITHUB_APP_ID GITHUB_APP_PRIVATE_KEY GITHUB_WEBHOOK_SECRET \
  GITHUB_OAUTH_CLIENT_ID GITHUB_OAUTH_CLIENT_SECRET
cluster_reachable || die "cannot reach $KCTX with $KUBECONFIG; run: mise run oldie:host"
key_file="${GITHUB_APP_PRIVATE_KEY/#\~/$HOME}"
[ -r "$key_file" ] || die "GITHUB_APP_PRIVATE_KEY=$key_file is not a readable file"

for ns in "$NS" cert-manager; do
  k create namespace "$ns" --dry-run=client -o yaml | k apply -f - >/dev/null
done
# Key names match secrets.github.keys in the chart's values.yaml.
k -n "$NS" create secret generic enzarb-github \
  --from-literal=app-id="$GITHUB_APP_ID" \
  --from-file=private-key="$key_file" \
  --from-literal=webhook-secret="$GITHUB_WEBHOOK_SECRET" \
  --from-literal=oauth-client-id="$GITHUB_OAUTH_CLIENT_ID" \
  --from-literal=oauth-client-secret="$GITHUB_OAUTH_CLIENT_SECRET" \
  --dry-run=client -o yaml | k apply -f - >/dev/null
# Keys referenced by the ClusterIssuers in enzarb-kubernetes/base/cluster-issuers.
# Cloudflare: an explicit CLOUDFLARE_API_TOKEN wins; otherwise keep what `oldie:cloudflare-token` stored.
if [ -n "${CLOUDFLARE_API_TOKEN:-}" ]; then
  k -n cert-manager create secret generic cloudflare-api-token \
    --from-literal=api-token="$CLOUDFLARE_API_TOKEN" \
    --dry-run=client -o yaml | k apply -f - >/dev/null
elif ! k -n cert-manager get secret cloudflare-api-token >/dev/null 2>&1; then
  die "no Cloudflare credential: set CLOUDFLARE_API_TOKEN in .env.oldie or run: mise run oldie:cloudflare-token"
fi
echo "applied $NS/enzarb-github; cert-manager/cloudflare-api-token present"
