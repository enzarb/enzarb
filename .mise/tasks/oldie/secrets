#!/usr/bin/env bash
#MISE description="Create enzarb-github, the GHCR chart-pull Secrets (enzarb-chart-registry, enzarb-updater-registry) and cloudflare-api-token from .env.oldie (idempotent)"
set -euo pipefail
# shellcheck source=/dev/null
. "${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd)}/.mise/lib/oldie.sh"
need kubectl jq
require_oldie_env GITHUB_APP_ID GITHUB_APP_PRIVATE_KEY GITHUB_WEBHOOK_SECRET \
  GITHUB_OAUTH_CLIENT_ID GITHUB_OAUTH_CLIENT_SECRET
cluster_reachable || die "cannot reach $KCTX with $KUBECONFIG; run: mise run oldie:host"
key_file="${GITHUB_APP_PRIVATE_KEY/#\~/$HOME}"
[ -r "$key_file" ] || die "GITHUB_APP_PRIVATE_KEY=$key_file is not a readable file"

for ns in "$NS" cert-manager; do
  k create namespace "$ns" --dry-run=client -o yaml | k apply -f - >/dev/null
done
# Key names match secrets.github.keys in the chart's values.yaml. The values come from the environment
# (exported by load_oldie_env) and the manifest is piped to kubectl, so no secret is ever an argument.
jq -n --rawfile pk "$key_file" --arg ns "$NS" '{
  apiVersion: "v1", kind: "Secret", type: "Opaque",
  metadata: {name: "enzarb-github", namespace: $ns},
  stringData: {
    "app-id": env.GITHUB_APP_ID,
    "private-key": $pk,
    "webhook-secret": env.GITHUB_WEBHOOK_SECRET,
    "oauth-client-id": env.GITHUB_OAUTH_CLIENT_ID,
    "oauth-client-secret": env.GITHUB_OAUTH_CLIENT_SECRET
  }}' | k apply -f - >/dev/null
# Cloudflare: an explicit CLOUDFLARE_API_TOKEN wins; otherwise keep what `oldie:cloudflare-token` stored.
if [ -n "${CLOUDFLARE_API_TOKEN:-}" ]; then
  jq -n '{apiVersion: "v1", kind: "Secret", type: "Opaque",
          metadata: {name: "cloudflare-api-token", namespace: "cert-manager"},
          stringData: {"api-token": env.CLOUDFLARE_API_TOKEN}}' | k apply -f - >/dev/null
elif ! k -n cert-manager get secret cloudflare-api-token >/dev/null 2>&1; then
  die "no Cloudflare credential: set CLOUDFLARE_API_TOKEN in .env.oldie or run: mise run oldie:cloudflare-token"
fi
# GHCR read credential (GHCR_USER + GHCR_TOKEN with read:packages, the same one oldie:host puts in the
# node's registries.yaml) for the private OCI chart: a dockerconfigjson Secret for the helm-controller
# (HelmChart spec.dockerRegistrySecret) and the bare token for enzarb-updater's registry polling.
# Built with jq from the environment and piped to kubectl: no credential is ever an argument.
if [ -n "${GHCR_USER:-}" ] && [ -n "${GHCR_TOKEN:-}" ]; then
  jq -n '{apiVersion: "v1", kind: "Secret", type: "kubernetes.io/dockerconfigjson",
          metadata: {name: "enzarb-chart-registry", namespace: "kube-system"},
          stringData: {".dockerconfigjson": ({auths: {"ghcr.io": {
            username: env.GHCR_USER, password: env.GHCR_TOKEN,
            auth: (env.GHCR_USER + ":" + env.GHCR_TOKEN | @base64)}}} | tojson)}}' | k apply -f - >/dev/null
  jq -n --arg ns "$NS" '{apiVersion: "v1", kind: "Secret", type: "Opaque",
          metadata: {name: "enzarb-updater-registry", namespace: $ns},
          stringData: {"registry-token": env.GHCR_TOKEN}}' | k apply -f - >/dev/null
  echo "applied kube-system/enzarb-chart-registry and $NS/enzarb-updater-registry"
else
  echo "note: GHCR_USER/GHCR_TOKEN not set; the private chart cannot be pulled (docs/oldie.md, one-time checklist)" >&2
fi
echo "applied $NS/enzarb-github; cert-manager/cloudflare-api-token present"
