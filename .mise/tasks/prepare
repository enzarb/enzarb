#!/usr/bin/env bash
#MISE description="Prepare a fresh worktree for an agent run: tools and npm dependencies (best-effort)"
# Run by the `prepare` node of .enzarb/workflows/issue.yaml (ADR-0020). Every
# step is best-effort: a failure is reported and the next step still runs.
set -uo pipefail
cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/../..}" || exit 1
status=0
mise install || { echo "prepare: mise install (root) failed" >&2; status=1; }
for lock in */package-lock.json; do
  dir=$(dirname "$lock")
  if [ -f "$dir/node_modules/.package-lock.json" ] && cmp -s "$lock" "$dir/node_modules/.package-lock.json" 2>/dev/null; then
    echo "prepare: $dir node_modules up to date"
    continue
  fi
  (cd "$dir" && mise install >/dev/null 2>&1; npm ci --prefer-offline --no-audit --no-fund) \
    || { echo "prepare: npm ci $dir failed" >&2; status=1; }
done
exit $status
