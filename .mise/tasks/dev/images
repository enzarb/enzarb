#!/usr/bin/env bash
#MISE description="Build the enzarb images as :dev and kind-load them: mise run dev:images [component...]"
#MISE usage='arg "[component]..." help="ui|sandbox-proxy|sandbox|operator|receiver (default: all)"'
set -euo pipefail
# shellcheck source=/dev/null
. "${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd)}/.mise/lib/dev.sh"
need docker kind

cluster_exists || die "kind cluster '$CLUSTER_NAME' not found; run: mise run dev:cluster"

if [ "$#" -gt 0 ]; then comps="$*"; elif [ -n "${usage_component:-}" ]; then comps="$usage_component"; else comps="$ALL_COMPONENTS"; fi

export DOCKER_BUILDKIT=1

for c in $comps; do
  spec="$(image_spec "$c")" || die "unknown component '$c' (one of: $ALL_COMPONENTS)"
  dir="${spec% *}"; image="${spec#* }:dev"
  [ -f "$ROOT/$dir/Dockerfile" ] || die "$dir/Dockerfile missing"
  # Every image builds with the repo root as context (one Cargo workspace, path deps).
  ctx="$ROOT"
  log "building $image from $dir"
  docker build -f "$ROOT/$dir/Dockerfile" -t "$image" "$ctx"
  log "loading $image into kind/$CLUSTER_NAME"
  kind load docker-image "$image" --name "$CLUSTER_NAME"
done
