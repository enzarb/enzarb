#!/usr/bin/env bash
#MISE description="Create namespace enzarb and the enzarb-github Secret from .env.dev"
set -euo pipefail
# shellcheck source=/dev/null
. "${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd)}/.mise/lib/dev.sh"
need kubectl
load_env

for v in GITHUB_APP_ID GITHUB_APP_PRIVATE_KEY GITHUB_WEBHOOK_SECRET GITHUB_OAUTH_CLIENT_ID GITHUB_OAUTH_CLIENT_SECRET; do
  [ -n "${!v:-}" ] || die "$v is empty in .env.dev"
done
key_file="${GITHUB_APP_PRIVATE_KEY/#\~/$HOME}"
[ -r "$key_file" ] || die "GITHUB_APP_PRIVATE_KEY=$key_file is not a readable file"

k create namespace "$NS" --dry-run=client -o yaml | k apply -f - >/dev/null
# Key names match secrets.github.keys in the chart's values.yaml.
k -n "$NS" create secret generic enzarb-github \
  --from-literal=app-id="$GITHUB_APP_ID" \
  --from-file=private-key="$key_file" \
  --from-literal=webhook-secret="$GITHUB_WEBHOOK_SECRET" \
  --from-literal=oauth-client-id="$GITHUB_OAUTH_CLIENT_ID" \
  --from-literal=oauth-client-secret="$GITHUB_OAUTH_CLIENT_SECRET" \
  --dry-run=client -o yaml | k apply -f - >/dev/null
echo "secret $NS/enzarb-github applied (session JWT and callback secrets are generated by the chart)"
