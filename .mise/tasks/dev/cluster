#!/usr/bin/env bash
#MISE description="Create the kind cluster 'enzarb' (NetworkPolicy-enforcing) and apply enzarb-kubernetes overlays/dev"
set -euo pipefail
# shellcheck source=/dev/null
. "${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd)}/.mise/lib/dev.sh"
need kind kubectl docker

KDIR="$ROOT/enzarb-kubernetes"
[ -d "$KDIR/overlays/dev" ] || die "$KDIR missing; run: mise run repos:init"
CNI="${ENZARB_DEV_CNI:-kindnet}"   # kindnet (default) | calico

if cluster_exists; then
  log "kind cluster '$CLUSTER_NAME' already exists"
else
  cfg="$KDIR/kind/cluster.yaml"
  if [ "$CNI" = calico ]; then
    # Dev patch (kept out of enzarb-kubernetes): same cluster, default CNI disabled.
    cfg="$(mktemp)"
    cat "$KDIR/kind/cluster.yaml" >"$cfg"
    printf '\nnetworking:\n  disableDefaultCNI: true\n  podSubnet: 10.244.0.0/16\n' >>"$cfg"
  fi
  log "creating kind cluster '$CLUSTER_NAME' (CNI: $CNI)"
  kind create cluster --config "$cfg"
  [ "$cfg" = "$KDIR/kind/cluster.yaml" ] || rm -f "$cfg"
fi

if [ "$CNI" = calico ] && ! k -n kube-system get ds calico-node >/dev/null 2>&1; then
  log "installing Calico $CALICO_VERSION"
  manifest="https://raw.githubusercontent.com/projectcalico/calico/$CALICO_VERSION/manifests/calico.yaml"
  kapply -f "$manifest"
  k -n kube-system set env ds/calico-node CALICO_IPV4POOL_CIDR=10.244.0.0/16 FELIX_IGNORELOOSERPF=true >/dev/null
  k -n kube-system rollout status ds/calico-node --timeout=5m
fi
k wait --for=condition=Ready nodes --all --timeout=5m

cd "$KDIR"
log "cert-manager"
kapply -k base/cert-manager
k -n cert-manager wait --for=condition=Available deploy --all --timeout=5m

log "Envoy Gateway"
kapply -k base/envoy-gateway/install
k wait --for=condition=Established crd/gateways.gateway.networking.k8s.io \
  crd/envoyproxies.gateway.envoyproxy.io --timeout=2m
k -n envoy-gateway-system wait --for=condition=Available deploy/envoy-gateway --timeout=5m

log "agent-sandbox, Capsule and pgop CRDs"
kapply -k base/agent-sandbox
kapply -k base/capsule/crds
k wait --for=condition=Established crd/tenants.capsule.clastix.io --timeout=2m
kapply -k base/pgop/crds
k wait --for=condition=Established crd/clusters.pgop.ruck.io --timeout=2m

log "overlays/dev"
kapply -k overlays/dev
k -n capsule-system wait --for=condition=Available deploy --all --timeout=5m
k -n pgop-system wait --for=condition=Available deploy --all --timeout=5m
k -n agent-sandbox-system wait --for=condition=Available deploy --all --timeout=5m

log "Capsule: treat system:serviceaccounts:$NS as Capsule users"
group="system:serviceaccounts:$NS"
if k get capsuleconfiguration default -o jsonpath='{.spec.users[*].name}' | tr ' ' '\n' | grep -qx "$group"; then
  echo "already configured"
else
  k patch capsuleconfiguration default --type=json \
    -p "[{\"op\":\"add\",\"path\":\"/spec/users/-\",\"value\":{\"kind\":\"Group\",\"name\":\"$group\"}}]"
fi

log "Gateway"
k -n enzarb-system wait --for=condition=Programmed gateway/enzarb --timeout=5m
k -n enzarb-system wait --for=condition=Ready certificate/enzarb-tls --timeout=5m

log "verifying that the CNI enforces NetworkPolicy"
probe="enzarb-netpol-probe"
k delete ns "$probe" --ignore-not-found --wait >/dev/null
k create ns "$probe" >/dev/null
trap 'k delete ns "$probe" --ignore-not-found --wait=false >/dev/null 2>&1 || true' EXIT
img="registry.k8s.io/e2e-test-images/agnhost:2.53"
k -n "$probe" run web --image="$img" --port=8080 --labels=app=web -- netexec --http-port=8080 >/dev/null
k -n "$probe" expose pod web --port=8080 >/dev/null
k -n "$probe" wait --for=condition=Ready pod/web --timeout=3m
reach() { k -n "$probe" run "c-$RANDOM" --rm -i --restart=Never --image="$img" --command -- \
  /agnhost connect web:8080 --timeout=5s >/dev/null 2>&1; }
reach || die "probe pod cannot reach web even before the NetworkPolicy exists"
k -n "$probe" apply -f - >/dev/null <<'POL'
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: { name: deny-all }
spec:
  podSelector: {}
  policyTypes: [Ingress]
POL
sleep 5
if reach; then
  die "NetworkPolicy is NOT enforced by this cluster's CNI. Recreate with: mise run dev:down && ENZARB_DEV_CNI=calico mise run dev:cluster"
fi
echo "NetworkPolicy enforced (CNI: $CNI)"
log "cluster ready: context $KCTX"
